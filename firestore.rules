rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Server Admin SDK uses IAM. Browser access to analytics is denied.
    match /luckyboxDaily/{document=**} {
      allow read, write: if false;
    }
    match /luckyboxStats/{document=**} {
      allow read, write: if false;
    }
  }
}
